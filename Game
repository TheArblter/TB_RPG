import java.util.Scanner;
import java.util.Random;
import java.util.Arrays;


public class Game {
	
	public static void main(String[] args) {
		Random rand = new Random();
		Scanner scan = new Scanner(System.in);
		
		int Health = 100;
		int Mana = 50;
		int GoblinHP = 80;
		int EmpowerUse = 0;
		
		
		//create the player and goblin
		
		Character player = new Character ( 
				Health, Mana,
	            new String[]{"Basic Attack", "Fireball", "Heal", "Empower", "Flee"});
		
		NPC Goblin = new NPC (GoblinHP);
		
		
		System.out.println("Welcom traveler!......");
		System.out.println("You have now encountered the MIGHTY regular goblin!!!");
		System.out.println("START FIGHT!");
		
		
		System.out.println("Player HP:" + player.getHealth()+"/100, MP:" + player.getMana()+"/50");
		System.out.println("Gobling HP:" + Goblin.getGoblinHP()+ "/80");
		
		while (player.getHealth() > 0 && Goblin.getGoblinHP() > 0 ) {
			System.out.println("Choose Action:");
			System.out.println("1: Basic Acttack\n2: Fireball\n3: Heal\n4: Empower\n5: Flee");
			
			int Actions = scan.nextInt();
			boolean Turn_over = false;
			int BA_min = 5 + EmpowerUse; // add empower effect to damages by adding the uses to min and multiplying the uses by 2 and adding it to max
			int BA_max = 10 + EmpowerUse*2;
			
			int FB_min = 10 + EmpowerUse;
			int FB_max = 25 + EmpowerUse*2;
			
			int H_min = 20 + EmpowerUse;
			int H_max = 30 + EmpowerUse*2;
			
			switch (Actions) {
			//basic attack
			case 1:  
				if (rand.nextInt(100) < 80) {// if random number from 0-100 is less that 80 it secceeds is its greater is fails
					
					int BA_damage = rand.nextInt(BA_max - BA_min+1) + BA_min; // Generate number from 0 - 5 and adds 5 to both sides shifting it to 5 - 10 (10 - 5 + 1) + 5) 
					System.out.println("Player used Basic Attack! It did" + BA_damage + "damage to the goblin!");
					Goblin.setGoblinHP(Goblin.getGoblinHP() - BA_damage);
				} else {
					System.out.println("The swift Goblin has evaded you weak attack!");
				}
				Turn_over = true;
				break;
			case 2: 
				if (player.getMana() >= 6) {
					
					int FB_damage = rand.nextInt(FB_max - FB_min + 1) + FB_min;
					System.out.println("Player used Fireball! It did" + FB_damage + "damage to the goblin!");
					Goblin.setGoblinHP(Goblin.getGoblinHP() - FB_damage);
					player.setMana(player.getMana() - 6);
				// code to display the current MP
				} else {
					System.out.println(".....Your tank is runing LOW! You cannot use Fireball");
				}
				Turn_over = true;
				break;
			case 3: 
				if (player.getMana() >= 8) {
					
					int Healing = rand.nextInt(H_max - H_min + 1) + H_min;
					System.out.println("Player used Heal! It healead" + Healing + "health points");
					int Healed_HP = player.getHealth() + Healing;
					if (Healed_HP > 100) {
						Healed_HP = 100;
					}
					player.setHealth(Healed_HP);
					player.setMana(player.getMana() - 8);
					// code to display current MP and HP
				} else {
					System.out.println("Oh oh......It seems like youre out of juice! Heal cannot be used");
				}
				Turn_over = true;
				break;
			case 4:
				if (player.getMana() >= 10) {
					EmpowerUse++;
					System.out.println("Player used Empower! Your minimum and maximum rolls have increacres for the following:");
					System.out.println("Basic Attack: " + BA_min + "-" + BA_max +"!");
					System.out.println("Fireball: " + FB_min + "-" + FB_max + "!");
					System.out.println("Heal: " + H_min + "-" + H_max +"!");
					
					player.setMana(player.getMana() - 10);
				} else {
					System.out.println("You need a little more milk before you can use this! Empower failed");
				}
				Turn_over = true;
				break;
			case 5:
				if (rand.nextInt(100) > 50) {
					System.out.println("It looks like leg day paid off! Player has successfully fled");
				} else {
					if (player.getMana() > 15) {
					player.setMana(player.getMana() - 15);
						System.out.println("Player has failed in fleeing!\n Your MP is now:" + player.getMana() + "/50" );
					} else {
						player.setHealth(player.getHealth() - 20);
						System.out.println("Why would you try to flee with no gas left in the tank?......Rookie move! Player has lost 20 HP");
					}
						
					}
					System.out.println("Player HP: " + player.getHealth() + "/100, MP: " + player.getMana() + "/50");
					System.out.println("Goblin HP: " + Goblin.getGoblinHP() + "/80");
					Turn_over = true;
					break;
			default:
				System.out.println("Now what made you choose that 😑 ....... Try again");
				break;
			
			}
			if (Goblin.getGoblinHP() > 0 && Turn_over) {
				System.out.println("Brace yourself! The Mighty regular Goblin is attacking!!");
				
				int GHit1 = 0;
				int GHit2 = 0;
				// goblin first attack
				if (rand.nextInt(100) < 60) {
						GHit1  = rand.nextInt(5) + 3;
						player.setHealth(player.getHealth() - GHit1);
						System.out.print("The first attack did" + GHit1);
					} else {
						GHit1 = -1;
						System.out.print("The first hit missed, ");
				}
				// goblin second attack
				if (rand.nextInt(100) < 60) {
					GHit2  = rand.nextInt(5) + 3;
					player.setHealth(player.getHealth() - GHit2);
					System.out.print(", and the second hit did" + GHit2);
					
				} else {
					GHit2 = -1;
					System.out.print("and the second hit missed!");
				}
				
		
			}
		}
		if (player.getHealth() <= 0) {
			System.out.println("Whomp, Whomp! You are too WEAK!\n The Mighty regular Goblin has won!");
		} else if (Goblin.getGoblinHP() >= 0) {
			System.out.println("What a Upset!\n The Mighty regular Goblin has been DEFEATED!");
		}
		
		scan.close();	
	}
	

}
